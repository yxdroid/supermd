{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SuperMD",
  "version": "0.1.2",
  "identifier": "com.supermd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SuperMD",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$PICTURE/**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: file: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src 'self' blob:; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": ["dmg", "msi", "nsis"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "shortDescription": "Fast Markdown viewer and editor",
    "longDescription": "SuperMD opens Markdown documents quickly and gives image-first navigation back to the source."
  }
}
